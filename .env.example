# Veloxa Cockpit Configuration
ENVIRONMENT=development
PORT=8000
FRONTEND_PORT=3000

# Backend SQLite Database
DATABASE_URL=sqlite:///./veloxa.db

# Security & Redaction
STRICT_SALARY_PRIVACY=true
MAX_CITATION_LIMIT=10

# Optional LLM Integration (System operates deterministically without keys)
GEMINI_API_KEY=
OPENAI_API_KEY=
USE_MOCK_LLM_FALLBACK=true
